{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/check-dashes.mjs && node scripts/check-voice.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "capture": "node scripts/capture.mjs",
    "share": "node scripts/share-images.mjs",
    "frames": "node scripts/measure-frames.mjs",
    "resume": "node scripts/resume-pdf.mjs",
    "test:e2e": "playwright test",
    "snapshot:renal": "uv run --no-project --with pytest==8.3.3 python scripts/snapshot-renal.py",
    "prepare": "git config core.hooksPath .githooks",
    "check:dashes": "node scripts/check-dashes.mjs"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lenis": "^1.3.27",
    "next": "16.4.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "shiki": "^4.6.0",
    "simple-icons": "^16.36.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "pdfjs-dist": "^6.5.438",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
